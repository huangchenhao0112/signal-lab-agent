APP_NAME=SignalLab Agent
APP_VERSION=0.1.0

LLM_API_KEY=在这里填写api key
LLM_BASE_URL=在这里填写模型api网页地址
LLM_MODEL=在这里填写你的模型名称
LLM_TIMEOUT=60

EMBEDDING_API_KEY=在这里填写embedding api key
EMBEDDING_BASE_URL=在这里填写模型embedding api网页地址
EMBEDDING_MODEL=在这里填写你的模型名称
EMBEDDING_DIMENSIONS=1024

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=signal_lab_agent
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password