  "experiments": {
    "FROZEN_SUPPORT_V1": {
      "name": "冻结测试集支撑恢复与重建质量",
      "sample_count": 3500,
      "snr_db": [-10, -5, 0, 5, 10, 20, 30],
      "samples_per_snr": 500,
      "aggregation": "mean_of_per_sample_metrics",
      "checkpoint_roles": {
        "NCSD-Net": "frozen_primary",
        "TFA-Net": "frozen_baseline_epoch_410",
        "HCTFR-Net": "project_reproduction_best_mse"
      },
      "metrics": ["hit_rate", "weighted_l2", "mse", "psnr_db", "renyi_entropy"],
      "sources": [
        "outputs/paper_figures/paper_ready/source_data/table_hctfr_frozen_protocol.csv",
        "outputs/results/hctfr_frozen_protocol_comparison.json",
        "outputs/protocol_registry/CANONICAL_RESULT_IDENTITIES.csv"
      ],
      "comparability": "仅同协议、同分组和相同指标可直接比较"
    },
    "FROZEN_STRICT_MAIN_V1": {
      "name": "冻结测试集严格峰值检测",
      "sample_count": 3500,
      "nms": "per_frame_1d",
      "minimum_peak_distance_bins": 4,
      "matching": "hungarian_one_to_one",
      "matching_tolerance_bins": 2,
      "known_true_component_count": true,
      "maximum_candidates": "2.5K",
      "default_threshold": 0,
      "aggregation": "mean_of_per_sample_metrics",
      "metrics": ["peak_f1", "fp_per_frame", "localization_mae"],
      "sources": [
        "outputs/reproduction_check/frozen_paired_official/frozen_group_means_official.csv",
        "outputs/paper_figures/paper_ready/source_data/table_hctfr_strict_peak_audited_per_sample.csv"
      ],
      "comparability": "仅相同阈值、候选数、NMS和匹配规则下可直接比较"
    },
    "FROZEN_GFSC_S5": {
      "name": "Table S5全局频率支撑覆盖率",
      "protocol_id_status": "normalized_by_agent_pending_registry_confirmation",
      "top_k_rule": "K=max(12,3Nc)",
      "tolerance_bins": 2,
      "aggregation": "mean_of_per_sample_metrics",
      "metrics": ["gfsc_at_k"],
      "sources": [
        "outputs/paper_figures/paper_ready/source_data/tableS5_global_frequency_support_coverage_clarified.csv"
      ],
      "comparability": "只能与同一GFSC@K表、同一分组结果比较"
    },
    "MATLAB_FIXED_S6": {
      "name": "Table S6 MATLAB可控信号固定工作点",
      "trials_per_scenario": 30,
      "aggregation": "mean_and_standard_deviation_across_paired_trials",
      "checkpoint_roles": {
        "NCSD-Net": "matlab_application_best_peak_recall",
        "HCTFR-Net": "project_reproduction_best_mse"
      },
      "metrics": ["peak_f1"],
      "sources": [
        "outputs/paper_figures/paper_ready/source_data/table_matlab_strict_peak_extended_baselines_clean.csv"
      ],
      "comparability": "只能在同一场景和相同工作点下比较；不得与冻结严格峰值结果横向比较"
    },
    "NCSD_EFFICIENCY_RTX5090_BATCH1": {
      "name": "NCSD-Net计算效率",
      "environment": {
        "python": "3.10.20",
        "pytorch": "2.9.0+cu128",
