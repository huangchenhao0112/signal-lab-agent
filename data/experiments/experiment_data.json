  "metric_definitions": {
    "hit_rate": {
      "meaning": "真实频率支撑落入预测候选频率附近的覆盖率",
      "tolerance_bins": 2,
      "warning": "主要衡量覆盖率，不充分惩罚误检，不能称为Peak F1"
    },
    "gfsc_at_k": {
      "meaning": "二维时频图沿时间维聚合后的全局Top-K频率支撑覆盖率",
      "warning": "不能与hit_rate或Peak F1直接比较"
    },
    "peak_f1": {
      "meaning": "严格峰值一对一匹配下Peak Precision与Peak Recall的调和平均",
      "warning": "不同阈值、信号集和检测协议之间不能直接比较"
    },
    "weighted_l2": {
      "meaning": "加权时频重建误差",
      "warning": "不能与检测类指标直接比较"
    }
  },
