      "name": "01 Health",
      "item": [
        {
          "name": "Agent Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\r\n    \"HTTP状态码为200\",\r\n    function () {\r\n        pm.response.to.have.status(200);\r\n    }\r\n);\r\n\r\npm.test(\r\n    \"Agent整体状态正常\",\r\n    function () {\r\n        const data = pm.response.json();\r\n\r\n        pm.expect(data.ok).to.eql(true);\r\n    }\r\n);\r\n\r\npm.test(\r\n    \"MySQL正常\",\r\n    function () {\r\n        const data = pm.response.json();\r\n\r\n        pm.expect(data.mysql).to.eql(true);\r\n    }\r\n);\r\n\r\npm.test(\r\n    \"Redis正常\",\r\n    function () {\r\n        const data = pm.response.json();\r\n\r\n        pm.expect(data.redis).to.eql(true);\r\n    }\r\n);\r\n\r\npm.test(\r\n    \"MCP正常\",\r\n    function () {\r\n        const data = pm.response.json();\r\n\r\n        pm.expect(data.mcp).to.eql(true);\r\n    }\r\n);\r\n\r\npm.test(\r\n    \"LangGraph正常\",\r\n    function () {\r\n        const data = pm.response.json();\r\n\r\n        pm.expect(data.graph).to.eql(true);\r\n    }\r\n);\r\n\r\npm.test(\r\n    \"Tool数量大于0\",\r\n    function () {\r\n        const data = pm.response.json();\r\n\r\n        pm.expect(\r\n            data.tool_count\r\n        ).to.be.above(0);\r\n    }\r\n);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/agent/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "agent",
                "health"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Agent Tools",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\r\n    \"HTTP状态码为200\",\r\n    function () {\r\n        pm.response.to.have.status(200);\r\n    }\r\n);\r\n\r\npm.test(\r\n    \"Tools接口成功\",\r\n    function () {\r\n        const data = pm.response.json();\r\n\r\n        pm.expect(data.ok).to.eql(true);\r\n        pm.expect(data.count).to.be.above(0);\r\n    }\r\n);\r\n\r\npm.test(\r\n    \"包含核心MCP工具\",\r\n    function () {\r\n        const data = pm.response.json();\r\n\r\n        const names = data.tools.map(\r\n            tool => tool.name\r\n        );\r\n\r\n        pm.expect(names).to.include(\r\n            \"get_model_metrics\"\r\n        );\r\n\r\n        pm.expect(names).to.include(\r\n            \"search_research_docs\"\r\n        );\r\n\r\n        pm.expect(names).to.include(\r\n            \"analyze_model_performance\"\r\n        );\r\n    }\r\n);"
                ]
              }
            }
          ],
